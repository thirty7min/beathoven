NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only. Vercel Cron sends it as "Authorization: Bearer <value>" to /api/cron/uploads.
CRON_SECRET=a-long-random-string
# Canonical URL for metadata. Set for Production only; previews fall back to VERCEL_URL, dev to localhost.
NEXT_PUBLIC_SITE_URL=https://beathoven.io
# Server-only. Unset skips the Safe Browsing check on profile links.
GOOGLE_SAFE_BROWSING_API_KEY=your-safe-browsing-api-key
# Optional path to a Chromaprint fpcalc binary. Vercel uses the bundled one; on macOS `brew install chromaprint` is enough.
# FPCALC_PATH=/usr/local/bin/fpcalc
# Local dev only: enables /api/dev/bots. Never set this on Vercel.
# ENABLE_DEV_TOOLS=true
